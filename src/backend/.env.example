# --- LLM (use these when shipping; OLLAMA_* still work as fallbacks) ---
LLM_PROVIDER=ollama
# Ollama on host: http://127.0.0.1:11434  |  Docker stack: http://ollama:11434
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1:latest
LLM_TIMEOUT_SEC=300
LLM_NUM_PREDICT=384
LLM_NUM_PREDICT_JSON=160
# auto = fast heuristics first | llm = always call model | keyword/heuristic = never call model
SITUATION_CLASSIFIER_MODE=auto
BEHAVIORAL_PLANNER_MODE=auto
EMBEDDINGS_ENABLED=true
OLLAMA_KEEP_ALIVE=15m
OLLAMA_THINK=false
# Required for openai_compat when calling OpenAI, Azure, Groq, etc.
LLM_API_KEY=

# Legacy (optional; used if LLM_BASE_URL / LLM_MODEL are empty)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest

SQLITE_PATH=./data/experiment.db
EDGE_TTS_VOICE=es-MX-DaliaNeural
# Prosody: rate/pitch add expressiveness (Azure/Edge SSML-style strings)
EDGE_TTS_RATE=+8%
EDGE_TTS_PITCH=+4Hz
EDGE_TTS_VOLUME=+0%
MAX_TTS_CHARS=2000
TTS_CHUNK_CHARS=240
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
ENDPOINT_SILENCE_MS=600
MAX_UTTERANCE_MS=30000
VAD_BACKEND=energy

# Comma-separated origins for browser dashboard (desktop Godot does not need CORS)
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
